# =============================================================================
# guitar-agent 环境变量示例
# 使用方式：
#   1. 复制本文件为 .env：  cp .env.example .env
#   2. 在 .env 中填入真实密钥
#   3. 永远不要把 .env 提交到 git
# =============================================================================

# ---- 阿里云 DashScope（默认 provider，支持 qwen 系列与 text-embedding-v3）----
API_KEY_Qwen=your_dashscope_api_key_here

# ---- 本地 sglang（可选，未部署可留空）----
SGLANG_API_KEY=local-no-key

# ---- Provider 切换（可选）----
# 默认走 config.yaml 的 provider 字段；如需临时切换，取消下面注释：
# MODEL_PROVIDER=sglang
# EMBEDDING_PROVIDER=sglang
